{
  "registry_type": "agent_registry",
  "version": "1.3.0-alpha",
  "agents": [
    {
      "id": "trading-agent",
      "name": "TEKRAM Trading Agent",
      "purpose": "Explain deterministic TEKRAM state, review paper signals, and prepare paper-only trade plans.",
      "status": "contract_ready",
      "capabilities": ["trading.analyze", "trading.signal.review", "trading.journal.prepare"],
      "allowed_mcp_ids": ["tradingview-mcp", "tekram-paper-api"],
      "permission_level": "paper_only",
      "hard_boundaries": ["no_live_orders", "no_broker_credentials", "no_money_movement"]
    },
    {
      "id": "research-agent",
      "name": "Research Agent",
      "purpose": "Gather, summarize, compare, and cite information from approved sources.",
      "status": "contract_ready",
      "capabilities": ["research.public", "research.repository"],
      "allowed_mcp_ids": ["github-connector"],
      "permission_level": "read_only_by_default",
      "hard_boundaries": ["source_required", "no_external_mutation"]
    },
    {
      "id": "developer-agent",
      "name": "Developer Agent",
      "purpose": "Inspect repositories and systems, diagnose failures, prepare changes, and verify approved work.",
      "status": "contract_ready",
      "capabilities": ["system.inspect", "developer.inspect", "developer.change.prepare"],
      "allowed_mcp_ids": ["github-connector", "openclaw-read-only"],
      "permission_level": "diagnostics_before_modification",
      "hard_boundaries": ["no_unapproved_deploy", "no_secret_mutation", "verification_required"]
    },
    {
      "id": "memory-agent",
      "name": "Memory Agent",
      "purpose": "Retrieve source-backed project knowledge and prepare governed Obsidian captures.",
      "status": "core_retrieval_candidate",
      "capabilities": ["memory.search", "memory.capture.prepare"],
      "allowed_mcp_ids": ["obsidian-vault-bridge"],
      "permission_level": "read_only_or_approved_write",
      "hard_boundaries": ["source_provenance_required", "write_requires_approval"]
    },
    {
      "id": "desktop-agent",
      "name": "Desktop Sensory Agent",
      "purpose": "Request fresh, visible, consent-bound desktop observations from the Windows companion.",
      "status": "core_integration_candidate",
      "capabilities": ["screen.see", "screen.watch.prepare"],
      "allowed_mcp_ids": ["windows-companion"],
      "permission_level": "ephemeral_visible_observation",
      "hard_boundaries": ["visible_indicator_required", "ephemeral_by_default", "no_hidden_monitoring"]
    },
    {
      "id": "automation-agent",
      "name": "Automation Agent",
      "purpose": "Prepare bounded event-driven workflows from registered events and capabilities.",
      "status": "contract_ready",
      "capabilities": ["automation.plan"],
      "allowed_mcp_ids": [],
      "permission_level": "planning_only",
      "hard_boundaries": ["no_unregistered_dispatch", "policy_gate_required"]
    }
  ]
}
